CREATE PROCEDURE sp_GetStudentResults
    @StudentID INT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        ResultID,
        TestName,
        Subject,
        Score,
        TotalMarks,
        CAST((CAST(Score AS FLOAT) / TotalMarks) * 100 AS DECIMAL(5,2)) AS Percentage,
        DateTaken
    FROM 
        StudentResults
    WHERE 
        StudentID = @StudentID
    ORDER BY 
        DateTaken DESC;
END;






CREATE PROCEDURE sp_GetUserEmbedding
    @Email NVARCHAR(100)
AS
BEGIN
    SELECT FaceEmbedding FROM Students
    WHERE Email = @Email
END







