ALTER PROCEDURE [dbo].[sp_InsertStudent]
    @FullName NVARCHAR(100),
    @Email NVARCHAR(100),
    @PasswordHash NVARCHAR(255),
    @ContactNumber NVARCHAR(20),
      @ActivationId UNIQUEIDENTIFIER,
	  @FaceEmbedding NVARCHAR(MAX),
    @FacePath VARCHAR(200)
AS
BEGIN
    INSERT INTO Students (FullName, Email, PasswordHash, ContactNumber,ActivationId,FaceEmbedding,FacePath)
    VALUES (@FullName, @Email, @PasswordHash, @ContactNumber,@ActivationId,@FaceEmbedding,@FacePath);
END;

