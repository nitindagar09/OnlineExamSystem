<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="OnlineExamSystem.AdminMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <title>Admin</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="../Styles/NavBar.css" />

    <link rel="stylesheet" href="../Styles/AdminViewStudent.css"/>

    <link rel="stylesheet" href="../Styles/AdminDashBoard.css"/>

    <link rel="stylesheet" href="../Styles/AdminHome.css"/>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

     <style>
     body {
         background-color: #c1d2e6;
         background-size: cover;
         background-position: center;
         height: 100vh;
         background-attachment: fixed;
     }
 </style>

</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg" id="mainNav">
            <div class="container-fluid">
                <div class="logo">
                    <i class="fa-solid fa-chart-simple"></i>
                    <h4>ExamSoft</h4>
                </div>

                <div class="collapse navbar-collapse" id="items">
                    <ul class="navbar-nav me-auto">
                        <li id="li1" class="nav-item"><a class="nav-link" href="Home.aspx">Home</a></li>
                        <li id="li2" class="nav-item"><a class="nav-link" href="AllCandidates">View Student</a></li>
                        <li id="li3" class="nav-item"><a class="nav-link" href="DashBoard.aspx">DashBoard</a></li>
                    </ul>
                </div>
                <div class="logOut">
                    <asp:Button ID="btnLogOut" runat="server" Text="Sign Out" OnClick="btnLogOut_Click" />
                </div>
            </div>
        </nav>
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolderAdmin" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap JS (needed for tab switching) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    

</html>
